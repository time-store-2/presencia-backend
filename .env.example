# Chaîne de connexion Postgres (Neon) — OBLIGATOIRE.
# Exemple : postgresql://presencia_owner:xxxx@ep-xxxx.eu-west-3.aws.neon.tech/presencia?sslmode=require
DATABASE_URL=postgresql://user:password@host/presencia?sslmode=require

# Clé secrète Payload (génère une longue chaîne aléatoire, ex : openssl rand -base64 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# URL publique du backend (utilisée pour les liens d'inscription).
# En local : http://localhost:3002 — en prod : https://ton-projet.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3002
